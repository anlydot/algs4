graph A {

    subgraph {
        rank = same

        node [color=red]
        edge [color=red, penwidth=3]

        3 4 5
        3 -- 4
        3 -- 5 [xlabel="cycle", fontcolor=red]
        4 -- 5
    }

    subgraph {
        node [color = blue]
        edge [color = blue, penwidth=3]
        1 0 6
        0 -- 1 [xlabel="path", fontcolor=blue]
        0 -- 6
    }

    // 0 -- 1
    0 -- 2 0 -- 5 
    // 0 -- 6
    // 3 -- 4  3 -- 5
    // 4 -- 5
    4 -- 6

    7 -- 8
    
    9 -- 10 9 -- 11 9 -- 12
    11 -- 12
}