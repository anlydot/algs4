graph Bipartite {
    
    subgraph {
        rank = same

        node [color = black]
        0 3 4 7 10 11
    }

    subgraph {
        rank = same

        node [color = red, fontcolor = red]
        1 2 5 6 8 9 12
    }
    0 -- 1
    0 -- 2
    0 -- 5
    0 -- 6
    1 -- 3
    3 -- 5
    4 -- 5
    4 -- 6
    6 -- 7
    7 -- 8
    8 -- 10
    9 -- 10
    9 -- 11
    10 -- 12
    11 -- 12

}